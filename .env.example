# ==========================================
# BESTIEZ MASTER ENVIRONMENT VARIABLES
# Copy this file to .env in the /backend directory
# ==========================================

# --- Backend Configuration ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/bestiez
JWT_SECRET=change_this_to_a_very_long_random_string
JWT_EXPIRE=7d

# --- Cloudinary (Image Storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Paystack (Nigerian Payments) ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# --- SPEEDAF (Logistics) ---
SPEEDAF_API_KEY=your_speedaf_api_key
SPEEDAF_BASE_URL=https://api.speedaf.com/v1

# --- Email Service (SendGrid, used via nodemailer in utils/sendEmail.js) ---
# FIX: sendEmail.js reads EMAIL_HOST/EMAIL_PORT/EMAIL_USER, not just
# EMAIL_SERVICE — added the ones that were missing.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_API_KEY=your_sendgrid_api_key
EMAIL_FROM=Bestiez <noreply@bestiez.com>

# --- CORS allow-list (used by backend/src/config/cors.js) ---
# FIX: config/cors.js reads these three but they were never documented here.
CLIENT_URL=http://localhost:8081
VENDOR_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# --- Field encryption (used by backend/src/utils/encryption.js to encrypt
#     vendor Alipay/WeChat payout IDs before they hit MongoDB) ---
# FIX: was missing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_a_64_char_hex_string

# --- WeChat Mini-Program (vendor-side login, see wechat-vendor/) ---
# FIX: was missing — required by vendorController.wechatLogin()
WECHAT_APPID=your_wechat_miniprogram_appid
WECHAT_SECRET=your_wechat_miniprogram_appsecret

# --- Push Notifications (backend/src/services/notificationService.js
#     uses expo-server-sdk, which needs no extra keys for basic use, but
#     an Expo access token unlocks higher rate limits) ---
EXPO_ACCESS_TOKEN=optional_expo_access_token

# --- Web Portals (Vendor & Admin) ---
REACT_APP_API_URL=http://localhost:5000/api

# --- Mobile App (Expo) ---
API_URL=http://192.168.1.100:5000/api
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
